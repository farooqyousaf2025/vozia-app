# Copy to `keystore.properties` (git ignored) and fill in.
#
# Generate a release key once:
#   keytool -genkeypair -v -alias voiza -keyalg RSA -keysize 2048 -validity 10000 \
#           -keystore voiza-release.jks
#
# `storeFile` is resolved relative to android/ unless it is absolute.
# With no keystore.properties present, `assembleRelease` still builds — it just
# produces app-release-unsigned.apk, which is what CI does.
storeFile=voiza-release.jks
storePassword=change-me
keyAlias=voiza
keyPassword=change-me
