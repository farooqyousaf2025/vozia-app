<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice: microphone capture for LiveKit publishing -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Keep CPU awake during active rooms -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Heads-up room activity notifications. Android 13+ asks at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Reserved for a future call-style foreground service (keeps audio alive
      with the screen off). No service is declared yet; permissions are
      harmless when unused, but remove them if you never add one.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:ignore="ForegroundServicesPolicy" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".VoizaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voiza"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!--
          Cleartext HTTP (http://10.0.2.2:4000 on the emulator, a LAN address on a
          physical device) is allowed only for debuggable builds by
          res/xml/network_security_config.xml; a release build refuses it. That is
          why android:usesCleartextTraffic is NOT set to true here.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Voiza">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
