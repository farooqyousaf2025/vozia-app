# =============================================================================
# Voiza — root environment file consumed by docker-compose.yml
# Copy to `.env` and change every secret before exposing this to the internet.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=voiza
POSTGRES_PASSWORD=voiza
POSTGRES_DB=voiza

# --- Backend -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://voiza:voiza@localhost:5432/voiza
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=*

# Signing key for user/admin JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# --- LiveKit SFU -------------------------------------------------------------
# Must match the `keys:` map in livekit.yaml.
# Generate: openssl rand -hex 16 / openssl rand -base64 32
LIVEKIT_URL=ws://localhost:7880
# Handed to clients in every livekit-token response. Keep it as localhost for a
# local stack; on a VPS this must be the address phones can route to.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=voiza-dev-access-key
LIVEKIT_API_SECRET=voiza-dev-secret-key-change-me-32chars
# Webhook JWTs are signed with LIVEKIT_API_KEY; `webhook.api_key` in livekit.yaml must match it.
LIVEKIT_TOKEN_TTL=21600

# --- Auth --------------------------------------------------------------------
# When set, EVERY OTP request issues this fixed code (local development only).
# Leave empty in production to get random codes logged to the backend console.
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=300

# --- SMS gateway -------------------------------------------------------------
# mock    = log the code to stdout (development; production boot refuses it)
# twilio  = needs TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM_NUMBER
# vonage  = needs VONAGE_API_KEY + VONAGE_API_SECRET (+ optional VONAGE_FROM)
# Twilio's Console has a test-credential pair and a +15005550006 magic number that
# accepts any code; that is the sandbox path, and it is the same code path live
# traffic takes.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Voiza

# --- Payments ----------------------------------------------------------------
# simulated = POST /api/wallet/recharge credits diamonds with no money behind it.
#             This is what the demo and the Android wallet screen use today.
# stripe    = the simulated endpoint answers 403; diamonds come from
#             POST /api/wallet/recharge/checkout + the Stripe webhook instead.
PAYMENTS_PROVIDER=simulated
# Secret key from the Stripe dashboard — `sk_test_...` is test mode, `sk_live_...`
# is real money. Required when PAYMENTS_PROVIDER=stripe.
STRIPE_SECRET_KEY=
# From `Stripe → Webhooks → endpoint` for POST /api/payments/stripe/webhook
# (`stripe listen --forward-to` prints it in test mode). The development default
# below is what the e2e suite signs its own webhooks with; production boots refuse
# to start while it is still set to it.
STRIPE_WEBHOOK_SECRET=whsec_development_only_not_a_real_secret
STRIPE_CURRENCY=usd
# Price of one diamond in the smallest currency unit (10 => $0.10 each, so the
# Stripe minimum of 50 means a 5-diamond floor).
STRIPE_CENTS_PER_DIAMOND=10

# --- Admin panel bootstrap ---------------------------------------------------
# The backend creates/updates this operator on boot if the panel has no users.
ADMIN_BOOTSTRAP_PHONE=+10000000000
ADMIN_BOOTSTRAP_OTP=424242
ADMIN_USERNAME=admin
ADMIN_PASSWORD=voiza-admin

# --- Push notifications (optional) -------------------------------------------
# Firebase Cloud Messaging v1. Leave both empty to run without push: the backend
# then records device tokens and logs sends instead of calling Google.
# 1. Create a Firebase project, enable Cloud Messaging, add the Android app with
#    the application id from android/app/build.gradle.kts (com.voiza.app).
# 2. Download google-services.json into android/app/ and apply the Google Services
#    Gradle plugin, so the client can obtain a registration token.
# 3. Create a service account with the "Cloud Messaging API Sender" role, download
#    its key, and point FCM_SERVICE_ACCOUNT_FILE at it (or mount it at the
#    GOOGLE_APPLICATION_CREDENTIALS path the Google client libraries expect).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# Must equal the channel id the app registers with NotificationManager.
PUSH_ANDROID_CHANNEL=voiza_activity

# --- Demo data ---------------------------------------------------------------
# Read by the backend container's entrypoint: 1 also applies database/seed.sql on
# boot (agency, hosts, three live rooms). Set 0 for a clean stack.
SEED_DEMO_DATA=1

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# --- Android (gradle.properties / BuildConfig) -------------------------------
VOIZA_API_BASE_URL=http://10.0.2.2:4000
VOIZA_LIVEKIT_URL=ws://10.0.2.2:7880
