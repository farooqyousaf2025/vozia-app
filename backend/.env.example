# Local development environment for the backend (`npm run dev`).
# Copy to backend/.env. When running under docker compose these values come from
# the root .env instead and this file is ignored.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://voiza:voiza@localhost:5432/voiza
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=30d

LIVEKIT_URL=ws://localhost:7880
# Address handed to clients in livekit-token responses; equals LIVEKIT_URL for local dev.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=voiza-dev-access-key
LIVEKIT_API_SECRET=voiza-dev-secret-key-change-me-32chars

OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=300

ADMIN_BOOTSTRAP_PHONE=+10000000000
ADMIN_BOOTSTRAP_OTP=424242
ADMIN_USERNAME=admin
ADMIN_PASSWORD=voiza-admin

CORS_ORIGIN=*

# Optional Firebase Cloud Messaging v1 server credentials.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# Optional Gmail SMTP alert delivery (OAuth2 preferred; app password requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=voziaapplication2026@gmail.com
SMTP_PASS=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
ALERT_EMAIL_FROM=voziaapplication2026@gmail.com
RESEND_API_KEY=

# Optional platform alert delivery via Gmail SMTP (STARTTLS on port 587), OAuth2, or Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=voziaapplication2026@gmail.com
SMTP_PASS=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
ALERT_EMAIL_FROM=voziaapplication2026@gmail.com
RESEND_API_KEY=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
