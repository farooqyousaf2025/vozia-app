# Local development environment for the backend (`npm run dev`).
# Copy to backend/.env. When running under docker compose these values come from
# the root .env instead and this file is ignored.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://voiza:voiza@localhost:5432/voiza
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=30d

LIVEKIT_URL=ws://localhost:7880
# Address handed to clients in livekit-token responses; equals LIVEKIT_URL for local dev.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=voiza-dev-access-key
LIVEKIT_API_SECRET=voiza-dev-secret-key-change-me-32chars

OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=300

ADMIN_BOOTSTRAP_PHONE=+10000000000
ADMIN_BOOTSTRAP_OTP=424242
ADMIN_USERNAME=admin
ADMIN_PASSWORD=voiza-admin

CORS_ORIGIN=*
